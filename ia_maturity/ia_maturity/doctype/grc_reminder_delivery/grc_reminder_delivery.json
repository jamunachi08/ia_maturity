{
  "doctype": "DocType",
  "name": "GRC Reminder Delivery",
  "module": "IA Maturity",
  "engine": "InnoDB",
  "autoname": "hash",
  "track_changes": 1,
  "field_order": [
    "delivery_key",
    "entity",
    "reference_name",
    "recipient",
    "subject",
    "email_queue",
    "status",
    "error",
    "notification_kind",
    "grc_department"
  ],
  "fields": [
    {
      "fieldname": "delivery_key",
      "label": "Delivery key",
      "fieldtype": "Data",
      "unique": 1,
      "reqd": 1
    },
    {
      "fieldname": "entity",
      "label": "Organization",
      "fieldtype": "Link",
      "options": "IA Maturity Entity",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "reference_name",
      "label": "Reference",
      "fieldtype": "Data"
    },
    {
      "fieldname": "recipient",
      "label": "Recipient",
      "fieldtype": "Link",
      "options": "User"
    },
    {
      "fieldname": "subject",
      "label": "Subject",
      "fieldtype": "Data"
    },
    {
      "fieldname": "email_queue",
      "label": "Email queue",
      "fieldtype": "Link",
      "options": "Email Queue"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Queued\nSent\nFailed",
      "default": "Queued"
    },
    {
      "fieldname": "error",
      "label": "Delivery error",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "notification_kind",
      "label": "Notification kind",
      "fieldtype": "Select",
      "options": "Reminder\nStatus\nClarification",
      "default": "Status"
    },
    {
      "fieldname": "grc_department",
      "label": "Grc Department",
      "fieldtype": "Link",
      "options": "GRC Department",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "GRC App Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}
