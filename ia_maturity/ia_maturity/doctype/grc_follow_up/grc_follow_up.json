{
  "doctype": "DocType",
  "name": "GRC Follow Up",
  "module": "IA Maturity",
  "engine": "InnoDB",
  "autoname": "hash",
  "track_changes": 1,
  "field_order": [
    "entity",
    "assignment",
    "note",
    "due_date",
    "assigned_to",
    "status",
    "last_reminded_on",
    "grc_department"
  ],
  "fields": [
    {
      "fieldname": "entity",
      "label": "Organization",
      "fieldtype": "Link",
      "options": "IA Maturity Entity",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "assignment",
      "label": "Assignment",
      "fieldtype": "Link",
      "options": "GRC Assessment Assignment"
    },
    {
      "fieldname": "note",
      "label": "Note",
      "fieldtype": "Small Text",
      "reqd": 1
    },
    {
      "fieldname": "due_date",
      "label": "Due date",
      "fieldtype": "Date"
    },
    {
      "fieldname": "assigned_to",
      "label": "Owner",
      "fieldtype": "Link",
      "options": "User"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Open\nCompleted",
      "default": "Open"
    },
    {
      "fieldname": "last_reminded_on",
      "label": "Last reminder",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "grc_department",
      "label": "Grc Department",
      "fieldtype": "Link",
      "options": "GRC Department",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "GRC App Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "GRC Customer",
      "read": 1
    },
    {
      "role": "GRC Organization Admin",
      "read": 1
    },
    {
      "role": "GRC Auditor",
      "read": 1
    },
    {
      "role": "GRC Reviewer",
      "read": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}
