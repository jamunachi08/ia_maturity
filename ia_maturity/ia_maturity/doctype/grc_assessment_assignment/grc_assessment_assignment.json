{
  "doctype": "DocType",
  "name": "GRC Assessment Assignment",
  "module": "IA Maturity",
  "engine": "InnoDB",
  "autoname": "hash",
  "track_changes": 1,
  "field_order": [
    "entity",
    "template",
    "respondent",
    "consultant",
    "reviewer",
    "due_date",
    "review_due_date",
    "workflow_state",
    "assessment",
    "needs_reassignment",
    "clarification",
    "last_reminded_on",
    "customer_pending",
    "grc_department"
  ],
  "fields": [
    {
      "fieldname": "entity",
      "label": "Organization",
      "fieldtype": "Link",
      "options": "IA Maturity Entity",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "template",
      "label": "Template",
      "fieldtype": "Link",
      "options": "IA Maturity Template",
      "reqd": 1
    },
    {
      "fieldname": "respondent",
      "label": "Customer owner",
      "fieldtype": "Link",
      "options": "User",
      "reqd": 1
    },
    {
      "fieldname": "consultant",
      "label": "Consultant",
      "fieldtype": "Link",
      "options": "User"
    },
    {
      "fieldname": "reviewer",
      "label": "Reviewer",
      "fieldtype": "Link",
      "options": "User"
    },
    {
      "fieldname": "due_date",
      "label": "Due date",
      "fieldtype": "Date"
    },
    {
      "fieldname": "review_due_date",
      "label": "Review due date",
      "fieldtype": "Date"
    },
    {
      "fieldname": "workflow_state",
      "label": "State",
      "fieldtype": "Select",
      "options": "Draft\nIn Progress\nSubmitted\nUnder Review\nClarification Required\nResubmitted\nApproved\nReport Released",
      "default": "Draft",
      "in_list_view": 1
    },
    {
      "fieldname": "assessment",
      "label": "Current assessment",
      "fieldtype": "Link",
      "options": "IA Maturity Assessment"
    },
    {
      "fieldname": "needs_reassignment",
      "label": "Needs reassignment",
      "fieldtype": "Check"
    },
    {
      "fieldname": "clarification",
      "label": "Clarification requested",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "last_reminded_on",
      "label": "Last reminder",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "customer_pending",
      "label": "Awaiting customer owner",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "grc_department",
      "label": "Grc Department",
      "fieldtype": "Link",
      "options": "GRC Department",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "GRC App Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "GRC Customer",
      "read": 1
    },
    {
      "role": "GRC Organization Admin",
      "read": 1
    },
    {
      "role": "GRC Auditor",
      "read": 1
    },
    {
      "role": "GRC Reviewer",
      "read": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}
